# Root .gitignore for HotelPro

# Dependencies
node_modules/

# Environment files
.env
.env.*
!.env.example

# Build and distribution
dist/
dist-ssr/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test and coverage artifacts
coverage/
*.lcov
.nyc_output/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Editor directories
.idea/
.vscode/*
!.vscode/extensions.json
*.sw?
