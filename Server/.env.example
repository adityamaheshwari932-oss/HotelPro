PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/hotelpro

# Authentication & JWT Configuration (secret should be at least 32 characters)
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_EXPIRES_IN=15m

# Initial One-Time Admin Setup Secret
ADMIN_SETUP_SECRET=your_high_entropy_admin_setup_secret_here

# Payment Provider Configuration (defaults to mock provider in development)
PAYMENT_PROVIDER=mock

# Stripe Payment Gateway (required only if PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=sk_test_placeholder_key_here
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret_here
